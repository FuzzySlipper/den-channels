{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "DenChannels": {
    "Database": {
      "Path": "data/den-channels.dev.db",
      "ApplyMigrationsOnStartup": true
    },
    "DenCore": {
      "BaseUrl": "http://127.0.0.1:5299",
      "UseStubProjectMetadata": true,
      "StubProjects": []
    },
    "LegacyWrites": {
      "TombstoneChannelMessages": false,
      "TombstoneGatewaySystemMessages": false
    },
    "LegacyObservation": {
      "TombstoneRoutes": false
    }
  }
}
